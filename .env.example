# Register this exact callback in the Spotify developer dashboard:
# http://127.0.0.1:3000/api/auth/callback (local)
# https://your-domain.vercel.app/api/auth/callback (production)
APP_URL=http://127.0.0.1:3000
SPOTIFY_CLIENT_ID=

# PostgreSQL connection string from Neon. These variables are SERVER ONLY.
DATABASE_URL=

# Generate a random secret, for example: openssl rand -base64 48
# Keep stable between deploys; changing this requires Spotify reauthorization.
SESSION_SECRET=
